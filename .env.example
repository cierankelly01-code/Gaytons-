# Copy to .env.local and fill in. NEVER commit .env.local.
#
# Supabase — project URL + keys (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key is SECRET — server-side only, full DB access. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Resend — transactional email (https://resend.com). Optional: if missing, orders still save, email is skipped.
RESEND_API_KEY=
# Where new-order notifications are sent (the deli's inbox).
ORDER_NOTIFY_EMAIL=

# Admin gate for /orders-admin. Use a long, random passphrase.
ADMIN_PASSWORD=
